rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public "jövő gyros fiúja" votes: anyone can read the totals and
    // add exactly one vote at a time to a known candidate.
    match /votes/{candidateId} {
      allow read: if true;
      allow create: if candidateId in ['tanar', 'bozsi', 'csoke', 'rabo', 'szewald', 'soltesz']
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
